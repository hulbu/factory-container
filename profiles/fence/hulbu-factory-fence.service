# Loads profiles/fence/hulbu-factory-fence BEFORE Docker starts, so no container is ever up unfenced after a boot.
# Its twin, hulbu-factory-fence-again.service, loads it once more after every Docker start, in case Docker flushed it.
# Install both: README "A fence on a shared machine".
[Unit]
Description=HulbuFactory container egress fence (before Docker starts)
Before=docker.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hulbu-factory-fence

[Install]
WantedBy=multi-user.target docker.service
